# ─── ZYL Genesis Deployment ──────────────────────────────────────────────────
# Copy this to .env and fill in before running deploy-zyl-genesis.js

# ─── Network ─────────────────────────────────────────────────────────────────
# Base Sepolia for testing:
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Base Mainnet (blocked until AUDIT_PASSED=true):
# BASE_RPC_URL=https://mainnet.base.org

# Deployer private key (0x prefixed). This EOA pays gas but never holds ZYL.
DEPLOYER_PRIVATE_KEY=0x...

# Basescan API key for contract verification
BASESCAN_API_KEY=...

# ─── Multisig Addresses ──────────────────────────────────────────────────────
# 3-of-5 Safe controlling treasury + ZYL ownership
MULTISIG_ADDRESS=0x...

# SparkStaking rewards pool (400M allocation)
STAKING_POOL_ADDRESS=0x...

# LP seeding wallet for Aerodrome (150M allocation)
LP_RESERVE_ADDRESS=0x...

# Ecosystem grants multisig (100M allocation)
GRANTS_MULTISIG_ADDRESS=0x...

# ─── Team Vesting ────────────────────────────────────────────────────────────
# Comma-separated beneficiary addresses (must sum to 150M ZYL)
TEAM_BENEFICIARIES=0xAlice...,0xBob...,0xCarol...
TEAM_AMOUNTS=50000000,50000000,50000000

# ─── Oracle Keys (separate per Vector 1.4) ───────────────────────────────────
# Settle/refund oracle (HSM-backed in prod)
ORACLE_SETTLE_ADDRESS=0x...

# Reputation oracle (Vector 1.4)
ORACLE_REP_ADDRESS=0x...

# Slash oracle (2-of-3 multisig in prod)
ORACLE_SLASH_ADDRESS=0x...

# ─── Token Config ────────────────────────────────────────────────────────────
# Base USDC address
# Sepolia: 0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Mainnet: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# ZYL wei per smallest USDC unit (multisig calibrates post-deploy)
ZYL_RATE_USDC=100

# ─── ZylogenJob V3 kernel deploy (deploy-zylogenjob-sepolia.js) ──────────────
# PAUSER role on the V3 kernel. Immutable in constructor.
# Sepolia recommendation: leave empty → defaults to deployer EOA.
# Mainnet: use a Gnosis Safe or cold wallet, NEVER the deployer.
KERNEL_PAUSER_ADDRESS=

# ERC-2771 trusted forwarder for meta-tx. Immutable in constructor.
# Leave empty for "no meta-tx" (recommended for testnet).
KERNEL_FORWARDER=

# ─── Mainnet Gate ────────────────────────────────────────────────────────────
# Set to true ONLY after both audits clear (spec §VII Phase 1)
# AUDIT_PASSED=true
